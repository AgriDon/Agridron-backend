{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;user=root;password=root;database=agridron_db"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "Agridron.Backend.API",
    "Audience": "Agridron.Frontend",
    "ExpirationMinutes": 1440
  },
  "Brevo": {
    "ApiUrl": "https://api.brevo.com/v3/smtp/email",
    "ApiKey": "${BREVO_API_KEY}",
    "SenderEmail": "noreply@agridron.pe",
    "SenderName": "AgriDron Solutions",
    "FrontendBaseUrl": "http://localhost:5173",
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
