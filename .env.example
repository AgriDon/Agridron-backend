# Local development environment for docker compose.
# Copy this file to .env and adjust the values if needed.
# .env is ignored by git; .env.example must stay versioned.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agridron_db
MYSQL_PORT=3306

# IAM - JWT Authentication (set a strong >= 32-char secret locally or via dotnet user-secrets)
JWT_SECRET=

# IAM - Brevo Transactional Email API (keep empty if Brevo:Enabled is false)
BREVO_API_KEY=
